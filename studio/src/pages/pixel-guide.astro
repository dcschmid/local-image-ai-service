---
import '../styles/studio.css';
const examples = [
  { id: 'pixel-loot', title: '32 · Tiny loot icon', subject: 'a red mushroom with white spots', note: 'One object, a simple silhouette and 24 colors. A good starting point for inventory icons.' },
  { id: 'pixel-character', title: '64 · Adventure character', subject: 'a small red-haired forest ranger in a green cloak holding a wooden staff', note: 'One complete character with a readable pose. Try changing the clothing or profession first.' },
  { id: 'pixel-isometric', title: '64 · Isometric hideaway', subject: 'a tiny timber cabin with a red roof and a glowing round window', note: 'One building on a small ground tile. Keep the perspective and light direction consistent.' },
  { id: 'pixel-landscape', title: '128 · Scenic world', subject: 'a quiet mountain lake with a small wooden cabin and tall pine trees', note: 'Foreground, focal point and distant scenery. Try 32 or 64 colors for a richer sky.' },
];
